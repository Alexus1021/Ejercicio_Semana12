using System;

namespace Ejercicio_Semana12_FA
{
    internal class Librería
    {
        private string[] nombresLibros = new string[0];
        private decimal[] preciosLibros = new decimal[0];

        
        public void Registrar()
        {
            Console.WriteLine("\n=== REGISTRAR LIBRO ===");

            Console.Write("Ingrese nombre del libro: ");
            string nombre = Console.ReadLine()?.Trim();

            
            if (string.IsNullOrEmpty(nombre))
            {
                Console.WriteLine("El nombre del libro no puede estar vacío.");
                return;
            }

            
            for (int i = 0; i < nombresLibros.Length; i++)
            {
                if (nombresLibros[i].Equals(nombre, StringComparison.OrdinalIgnoreCase))
                {
                    Console.WriteLine("El libro ya está registrado.");
                    return;
                }
            }

            Console.Write("Ingrese precio del libro: ");
            string precioTexto = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(precioTexto))
            {
                Console.WriteLine("El precio no puede estar vacío.");
                return;
            }

            if (!decimal.TryParse(precioTexto, out decimal precio))
            {
                Console.WriteLine("El precio debe ser numérico.");
                return;
            }

            if (precio < 0)
            {
                Console.WriteLine("El precio no puede ser negativo.");
                return;
            }

            if (precio > 1000)
            {
                Console.WriteLine("El precio no puede superar los 1000.");
                return;
            }

            
            Array.Resize(ref nombresLibros, nombresLibros.Length + 1);
            Array.Resize(ref preciosLibros, preciosLibros.Length + 1);

            nombresLibros[nombresLibros.Length - 1] = nombre;
            preciosLibros[preciosLibros.Length - 1] = precio;

            Console.WriteLine("Libro registrado correctamente.");
        }

        
        public void Mostrar()
        {
            Console.WriteLine("\n=== LISTADO DE LIBROS ===");

            if (nombresLibros.Length == 0)
            {
                Console.WriteLine("No hay libros registrados.");
                return;
            }

            for (int i = 0; i < nombresLibros.Length; i++)
            {
                Console.WriteLine($"{i + 1}. {nombresLibros[i]} - S/{preciosLibros[i]:0.00}");
            }
        }

        
        public void Modificar()
        {
            Console.WriteLine("\n=== MODIFICAR LIBRO ===");

            Console.Write("Ingrese el nombre del libro a modificar: ");
            string nombreBuscar = Console.ReadLine()?.Trim();

            int index = Array.FindIndex(nombresLibros, n => n.Equals(nombreBuscar, StringComparison.OrdinalIgnoreCase));

            if (index == -1)
            {
                Console.WriteLine("El libro no existe.");
                return;
            }

            Console.Write("Ingrese nuevo nombre: ");
            string nuevoNombre = Console.ReadLine()?.Trim();

            if (string.IsNullOrEmpty(nuevoNombre))
            {
                Console.WriteLine("El nombre no puede estar vacío.");
                return;
            }

            
            for (int i = 0; i < nombresLibros.Length; i++)
            {
                if (i != index && nombresLibros[i].Equals(nuevoNombre, StringComparison.OrdinalIgnoreCase))
                {
                    Console.WriteLine("Ya existe un libro con ese nombre.");
                    return;
                }
            }

            Console.Write("Ingrese nuevo precio: ");
            string precioTexto = Console.ReadLine()?.Trim();

            if (!decimal.TryParse(precioTexto, out decimal nuevoPrecio))
            {
                Console.WriteLine("El precio debe ser numérico.");
                return;
            }

            if (nuevoPrecio < 0 || nuevoPrecio > 1000)
            {
                Console.WriteLine("El precio debe ser entre 0 y 1000.");
                return;
            }

            
            nombresLibros[index] = nuevoNombre;
            preciosLibros[index] = nuevoPrecio;

            Console.WriteLine("Libro modificado correctamente.");
        }

        
        public void Eliminar()
        {
            Console.WriteLine("\n=== ELIMINAR LIBRO ===");

            Console.Write("Ingrese el nombre del libro a eliminar: ");
            string nombreEliminar = Console.ReadLine()?.Trim();

            int index = Array.FindIndex(nombresLibros, n => n.Equals(nombreEliminar, StringComparison.OrdinalIgnoreCase));

            if (index == -1)
            {
                Console.WriteLine("El libro no existe.");
                return;
            }

            
            string[] nuevosNombres = new string[nombresLibros.Length - 1];
            decimal[] nuevosPrecios = new decimal[preciosLibros.Length - 1];

            int j = 0;
            for (int i = 0; i < nombresLibros.Length; i++)
            {
                if (i == index) continue;
                nuevosNombres[j] = nombresLibros[i];
                nuevosPrecios[j] = preciosLibros[i];
                j++;
            }

            nombresLibros = nuevosNombres;
            preciosLibros = nuevosPrecios;

            Console.WriteLine("Libro eliminado correctamente.");
        }
    }
}
